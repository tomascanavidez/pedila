# =============================================================================
# PEDILA — variables de entorno
# Copiá este archivo como .env (desarrollo) o como ~/pedila/shared/.env (servidor)
# y completá los valores. Nunca subas el .env real al repositorio.
# La tabla completa con descripciones está en el README › Variables de entorno.
# =============================================================================

# --- Base de datos (MySQL 5.7+/8 o MariaDB 10.4+) ---------------------------------
# Formato: mysql://USUARIO:CLAVE@HOST:PUERTO/BASE  (si la clave tiene símbolos, codificalos: @ -> %40)
# En Ferozo: creá la base y el usuario desde el panel (MySQL) y usá host 127.0.0.1 o el que indique el panel.
DATABASE_URL="mysql://pedila:cambiar-esta-clave@127.0.0.1:3306/pedila"
# Conexiones por proceso (2 instancias web + worker ≈ 15 conexiones con el valor 5).
DB_POOL_LIMIT=5

# Solo para desarrollo: bases APARTE para los tests (nunca la de producción).
# DATABASE_URL_TEST="mysql://pedila:clave@127.0.0.1:3306/pedila_test"
# DATABASE_URL_E2E="mysql://pedila:clave@127.0.0.1:3306/pedila_e2e"

# --- Aplicación ---------------------------------------------------------------------
# URL pública (con https:// en producción, sin barra final). Se usa en emails y en Mercado Pago.
APP_URL="http://localhost:3000"
# Secreto para firmar las sesiones. Generalo con:  openssl rand -base64 32
AUTH_SECRET="reemplazar-por-un-secreto-largo-y-aleatorio"
# La app corre detrás de un proxy inverso (nginx/Apache): confiar en el host que reenvía.
AUTH_TRUST_HOST=true
# Opcional: login con Google (crear credenciales OAuth en Google Cloud Console).
# URI de redirección autorizada: https://TU-DOMINIO/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- Pagos: Mercado Pago (Checkout Pro) --------------------------------------------
# mercadopago | simulado. Si se deja vacío: Mercado Pago si hay token, si no simulado.
PAYMENTS_PROVIDER=
# Credenciales de PRUEBA por defecto (TEST-...). Para cobrar de verdad usá las de producción.
MP_ACCESS_TOKEN=
# Clave secreta de Webhooks (Mercado Pago › Tus integraciones › Webhooks). Valida la firma x-signature.
MP_WEBHOOK_SECRET=
# true = usa el link de sandbox del checkout (modo prueba). Poner false con credenciales de producción.
MP_USE_SANDBOX=true
# Solo para demos/staging: permite el checkout simulado aunque NODE_ENV sea production.
ALLOW_SIMULATED_PAYMENTS=false

# --- Email (SMTP; por ejemplo una casilla creada en Ferozo) ---------------------------
# Si SMTP_HOST queda vacío, los correos se registran en el log y no se envían.
SMTP_HOST=
# 465 con SMTP_SECURE=true (SSL) o 587 con SMTP_SECURE=false (STARTTLS)
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=no-responder@tudominio.com.ar
SMTP_PASS=
MAIL_FROM="PEDILA <no-responder@tudominio.com.ar>"

# --- Archivos subidos ----------------------------------------------------------------
# En producción usá una ruta absoluta fuera de las releases (la pone ecosystem.config.js).
UPLOAD_DIR=./uploads
UPLOAD_MAX_MB=5

# --- Procesos (PM2) ----------------------------------------------------------------
# Puerto local de la app (el proxy inverso apunta acá). Solo escucha en 127.0.0.1.
PORT=3000
# Instancias web en modo cluster: 2 permite recargar sin cortar el servicio; con 1 GB de RAM usá 1.
WEB_INSTANCES=2
WEB_MAX_OLD_SPACE_MB=384
WEB_MAX_MEMORY=480M
WORKER_MAX_OLD_SPACE_MB=192
WORKER_MAX_MEMORY=260M

# --- Otros -----------------------------------------------------------------------------
# Canal WhatsApp: la interfaz existe pero no hay proveedor conectado (ver README › Decisiones).
WHATSAPP_ENABLED=false
# debug | info | warn | error
LOG_LEVEL=info
