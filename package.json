{
  "name": "pedila",
  "version": "1.0.0",
  "private": true,
  "description": "PEDILA — marketplace B2B de compras mayoristas en pool para comercios de Argentina",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "next dev",
    "dev:worker": "tsx watch --conditions=react-server src/worker/index.ts",
    "build": "prisma generate && next build && npm run build:worker && node scripts/prepare-standalone.mjs",
    "build:worker": "node scripts/build-worker.mjs",
    "start": "node .next/standalone/server.js",
    "start:worker": "node dist/worker.mjs",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset --force",
    "setup": "node scripts/setup.mjs",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "dev:all": "node scripts/dev-all.mjs",
    "local": "npm run setup && npm run dev:all",
    "worker:once": "node dist/worker.mjs --once",
    "init:prod": "node scripts/inicializar-produccion.mjs"
  },
  "dependencies": {
    "@prisma/adapter-mariadb": "7.10.1",
    "@prisma/client": "7.10.1",
    "bcryptjs": "3.0.3",
    "dotenv": "^17.0.0",
    "lucide-react": "1.61.0",
    "mariadb": "3.5.4",
    "next": "16.4.3",
    "next-auth": "5.0.0-beta.32",
    "node-cron": "4.6.0",
    "nodemailer": "8.0.11",
    "pdf-lib": "1.17.1",
    "prisma": "7.10.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "8.0.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "0.28.2",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  },
  "allowScripts": {
    "@prisma/engines@7.10.1": true,
    "esbuild@0.28.2": true,
    "prisma@7.10.1": true,
    "unrs-resolver@1.12.2": true
  }
}
